[Unit]
Description=MATRIX ACP Provider Server (INACTIVE until funded+activated)
After=network-online.target iclone-token-refresh.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=iclone
Group=iclone
WorkingDirectory=/opt/iclone
ExecStart=/opt/iclone/venv312/bin/python3.12 /opt/iclone/agent/server.py
Restart=always
RestartSec=15
StandardOutput=append:/var/log/iclone/matrix-server.log
StandardError=append:/var/log/iclone/matrix-server.log
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/iclone"
Environment="ACP_CONFIG_DIR=/home/iclone/.config/acp-matrix/acp"
Environment="ICLONE_AGENT_NAME=MATRIX"
Environment="ICLONE_OFFERINGS_FILE=published_offerings_matrix.json"
EnvironmentFile=/opt/iclone/.env
EnvironmentFile=-/home/iclone/.env.local
LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
