# ============================================================================
# iCLONE — Public Voice (X / Twitter) environment
# Lives at /opt/iclone-x/x.env on the droplet — SEPARATE from the ACP .env.
# chmod 600. NEVER commit the real file. This is the .example template.
# ============================================================================

# --- master switches --------------------------------------------------------
# X_ENABLED  : kill-switch. false = engine runs but sends/reads nothing.
# X_MODE     : dry_run | review | autonomous
#   dry_run    → logs what it WOULD do, sends nothing (safe first run)
#   review     → queues drafts to /opt/iclone-x/drafts.jsonl for your approval
#   autonomous → acts within policy, no human in the loop (your chosen mode)
X_ENABLED=false
X_MODE=autonomous

# --- identity ---------------------------------------------------------------
X_HANDLE=icloneframe
X_OWNER_HANDLE=

# --- X API credentials ------------------------------------------------------
# Create an app at https://developer.x.com → Projects & Apps.
# Needs OAuth1.0a (the 4 keys below) for posting + liking AS the account,
# plus the Bearer for reads. NOTE: reading mentions/verified status requires
# the BASIC tier ($100/mo) or higher — Free tier cannot read mentions.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- LLM (reuses the same Anthropic key as the ACP stack via /opt/iclone/.env) ---
# X_MODEL defaults to claude-opus-4-8 (the neural_soul base model).
X_MODEL=claude-opus-4-8
X_MAX_REPLY_TOKENS=400

# --- engagement policy ------------------------------------------------------
X_REPLY_VERIFIED_ONLY=true     # reply only to blue/gold/business-verified accounts
X_LIKE_VERIFIED_ONLY=false     # like genuine praise from any account (owner choice)
X_REQUIRE_QUESTION=true        # reply only to direct questions
X_REQUIRE_MENTION=true         # reply only when @icloneframe is mentioned
X_MAX_TWEET_CHARS=280

# --- cadence + rate limits (defense-in-depth + cost) ------------------------
X_POLL_INTERVAL=180
X_MAX_REPLIES_PER_HOUR=5
X_MAX_REPLIES_PER_DAY=30
X_MAX_LIKES_PER_HOUR=20
X_MAX_LIKES_PER_DAY=100
X_MENTIONS_PER_POLL=20
