# ========================
# CLONE — .gitignore
# ========================

# Environment & Secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
auth.json

# Per-owner personal data (PII) — LOCAL ONLY, never committed or pushed
**/owner.local.md
*.local
*.local.*

# Hermes keeps ALL of its state — auth.json, config.yaml (which is where project trust
# is recorded), sessions, skills — in $HERMES_HOME (~/.hermes), outside this repo. The
# only project-local Hermes path is .hermes/skills, the tracked symlink to ../skills.
# Anything else that appears under .hermes/ here is local scratch: ignore it.
.hermes/*
!.hermes/skills

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
pip-log.txt
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.cover
.hypothesis/
.mypy_cache/
.ruff_cache/

# Node / JS
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDEs
.vscode/
.idea/

# Logs
logs/
*.log

# Database
*.sqlite
*.db

# Docker
docker-compose.override.yml

# Misc
.cache/
tmp/
temp/.venv312/

# --- Public Voice (X) runtime state — never commit ---
.x-state/
**/x.env
!ops/social/x.env.example

# --- reforço reconciliacao droplet ---
venv312/
.venv312/
*.bak
*.bak.*
ops/pingpong_state.json
ops/.offerings_state.json
market_map_*.json
.offerings_state.json
*_state.json
*.pid
config.json
.config/
