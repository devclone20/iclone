[Unit]
Description=iCLONE Daily Training Cycle (oneshot, driven by .timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=iclone
Group=iclone
WorkingDirectory=/opt/iclone

ExecStart=/opt/iclone/venv312/bin/python3.12 -m agent.iclone.training.scheduler

StandardOutput=append:/var/log/iclone/training.log
StandardError=append:/var/log/iclone/training.log

Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/iclone"
Environment="ACP_CONFIG_DIR=/home/iclone/.config/acp-iclone/acp"
EnvironmentFile=/opt/iclone/.env

TimeoutStartSec=1800
