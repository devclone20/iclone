[Unit]
Description=VEGETA Client Autopilot (hires iCLONE — odd minutes)
After=network-online.target iclone-server.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=iclone
Group=iclone
WorkingDirectory=/opt/iclone

ExecStart=/opt/iclone/venv312/bin/python3.12 /opt/iclone/ops/client_autopilot.py

Restart=always
RestartSec=20

StandardOutput=append:/var/log/iclone/vegeta.log
StandardError=append:/var/log/iclone/vegeta.log

Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/iclone"
Environment="ACP_CONFIG_DIR=/home/iclone/.config/acp-vegeta/acp"
Environment="AUTOPILOT_AGENT_NAME=VEGETA"
Environment="TARGET_WALLET=0x44cc25d55a4291b92f52062ba023ca1f14206664"
Environment="TARGET_NAME=iCLONE"
Environment="JOBS_FILE=ops/client_jobs_vegeta.json"
Environment="FIRE_PERIOD_MIN=8"
Environment="FIRE_OFFSET_MIN=0"
Environment="LOG_PATH=/var/log/iclone/vegeta.log"
EnvironmentFile=/opt/iclone/.env
EnvironmentFile=-/home/iclone/.env.local

LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
